        "jsCode": "// Meta answers refused messages with a normal response, so turn them into a real error (it reaches Fenjan 2 and Telegram).\nconst r = $input.first().json;\nconst code = Number(r.statusCode || 0);\nif (code >= 400 || r.error) {\n  const why = String(r.error?.message || r.headers?.['www-authenticate'] || r.body || 'unknown reason').slice(0, 300);\n  throw new Error('Meta did not deliver the reply to ' + $('Decide Reply').first().json.platform + ' customer ' + $('Decide Reply').first().json.sender_id + ': ' + why);\n}\nreturn [{ json: { delivered: true, message_id: r.message_id || '' } }];"
      },
