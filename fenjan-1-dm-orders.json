    {
      "parameters": {
        "jsCode": "// One item per real customer text. Web demo items come from the website; others from Meta.\nconst out = [];\nfor (const item of $input.all()) {\n  const b = item.json.body;\n  if (b && b.session) {\n    const sid = String(b.session).replace(/[^a-zA-Z0-9]/g, '').slice(0, 16);\n    const text = String(b.text || '').trim().slice(0, 1000);\n    if (sid && text) out.push({ json: { platform: 'Web', sender_id: 'web-' + sid, text } });\n    continue;\n  }\n  const platform = $prevNode.name.includes('Instagram') ? 'Instagram' : 'Messenger';\n  for (const m of (item.json.messaging || [])) {\n    if (!m.message || m.message.is_echo || !m.message.text) continue;\n    out.push({ json: { platform, sender_id: String(m.sender.id), text: String(m.message.text).slice(0, 1000) } });\n  }\n}\nreturn out.slice(0, 1);"
      },
