      "id": "fenjan-006",
      "name": "Find Cart",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        720,
        160
      ],
      "retryOnFail": true,
      "executeOnce": true,
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const msg = $('Read Message').first().json;\nconst menu = $('Read Menu').all().map(i => i.json).filter(m => String(m.item_id || '').trim());\nconst cartRow = $('Find Cart').all().map(i => i.json).find(r => String(r.customer_id) === msg.sender_id && r.status === 'open');\nconst prompt = [\n  'You take orders for Fenjan, a café in Cairo, over Messenger and Instagram DMs. Customers write in Egyptian Arabic, English or Franco-Arabic (e.g. \"3ayez 2 latte\").',\n  'Return ONLY JSON: {\"intent\":\"greeting|menu|order|details|confirm|cancel|question|human\",\"items\":[{\"item_id\":\"D01\",\"qty\":1}],\"remove\":[\"D01\"],\"replace_cart\":false,\"fulfilment\":\"pickup|delivery|\",\"address\":\"\",\"language\":\"ar|en\",\"answer\":\"\"}',\n  'intent rules: \"order\" = adding or changing items (put them in items, use only item_id values from MENU, map nicknames using the words field). \"remove\" lists items to take out. replace_cart=true only if the customer clearly starts a new order.',\n  '\"details\" = only says pickup/delivery or gives an address. \"confirm\" = agrees to place the current cart (yes, ok, confirm, تمام, أكد, تأكيد). \"cancel\" = wants to cancel. \"human\" = complaint, problem, or asks for a person. \"menu\" = asks what you have or prices. \"greeting\" = only hello.',\n  '\"question\" = anything else: write a short friendly answer (max 2 sentences, same language, only facts from MENU) in answer. Never invent items or prices. fulfilment and address can be filled with any intent if mentioned. language = ar if the customer writes Arabic or Franco, else en.',\n  'MENU: ' + JSON.stringify(menu.map(m => ({ id: m.item_id, en: m.name_en, ar: m.name_ar, price: m.price_egp, available: m.available, words: m.keywords }))),\n  'CURRENT CART: ' + (cartRow ? cartRow.items_json : '[]') + ' | fulfilment: ' + (cartRow?.fulfilment || 'unknown'),\n  'CUSTOMER MESSAGE: ' + msg.text,\n].join('\\n');\nreturn [{ json: { prompt } }];"
      },
      "id": "fenjan-007",
      "name": "Build AI Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        160
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-3.1-flash-lite:generateContent",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googlePalmApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ contents: [{ parts: [{ text: $json.prompt }] }], generationConfig: { responseMimeType: 'application/json', temperature: 0.1 } }) }}",
        "options": {
          "timeout": 45000
        }
      },
      "id": "fenjan-008",
      "name": "AI Read Order",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        160
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// The AI only reads the message. Items, prices and totals always come from the Menu sheet.\nconst DELIVERY_FEE = 25, OPEN_HOUR = 8, CLOSE_HOUR = 24, MAX_QTY = 20;\nconst msg = $('Read Message').first().json;\nconst menu = $('Read Menu').all().map(i => i.json).filter(m => String(m.item_id || '').trim());\nconst byId = Object.fromEntries(menu.map(m => [String(m.item_id).trim().toUpperCase(), m]));\nconst isOn = m => /^(yes|true|1|y)$/i.test(String(m.available ?? 'yes').trim());\nconst cartRow = $('Find Cart').all().map(i => i.json).find(r => String(r.customer_id) === msg.sender_id && r.status === 'open');\nlet cart = []; try { cart = cartRow ? JSON.parse(cartRow.items_json || '[]') : []; } catch (e) { cart = []; }\nlet fulfilment = cartRow?.fulfilment || '', address = cartRow?.address || '';\nlet ai = null; try { ai = JSON.parse(($json.candidates?.[0]?.content?.parts || []).map(p => p.text).join('')); } catch (e) { ai = null; }\nconst ar = ai ? ai.language === 'ar' : /[\\u0600-\\u06FF]/.test(msg.text);\nconst t = (en, a) => ar ? a : en;\nconst EGP = t('EGP', 'ج.م');\nif (ai && ['pickup', 'delivery'].includes(ai.fulfilment)) fulfilment = ai.fulfilment;\nif (ai && String(ai.address || '').trim().length > 5) address = String(ai.address).trim().slice(0, 200);\nconst sub = () => cart.reduce((s, l) => s + l.qty * l.price, 0);\nconst fee = () => fulfilment === 'delivery' ? DELIVERY_FEE : 0;\nconst cartText = () => cart.map(l => `${l.qty} × ${ar ? l.name_ar : l.name} — ${l.qty * l.price} ${EGP}`).join('\\n')\n  + (fee() ? `\\n${t('Delivery', 'التوصيل')} — ${fee()} ${EGP}` : '') + `\\n${t('Total', 'الإجمالي')}: ${sub() + fee()} ${EGP}`;\nconst menuText = () => {\n  const cats = {};\n  for (const m of menu.filter(isOn)) (cats[m.category] = cats[m.category] || []).push(`${m.item_id} · ${ar ? m.name_ar : m.name_en} — ${m.price_egp}`);\n  return t('☕ Fenjan menu (EGP)', '☕ منيو فنجان (بالجنيه)') + Object.entries(cats).map(([c, l]) => `\\n\\n${c}\\n` + l.join('\\n')).join('')\n    + t('\\n\\nJust type your order, e.g. \"2 spanish latte and a croissant, delivery\".', '\\n\\nاكتب طلبك، مثلًا: \"٢ سبانش لاتيه وكرواسون، توصيل\".');\n};\nconst nextStep = () => !fulfilment ? t('Pickup or delivery? 🚶‍♀️🛵', 'استلام من المحل ولا توصيل؟ 🚶‍♀️🛵')\n  : fulfilment === 'delivery' && !address ? t('Please send your delivery address 📍', 'ابعتلي عنوان التوصيل 📍')\n  : t('Reply \"confirm\" to place your order ✅', 'اكتب \"تأكيد\" عشان نبدأ تحضير طلبك ✅');\nconst hour = Number($now.setZone('Africa/Cairo').toFormat('H'));\nconst isOpen = hour >= OPEN_HOUR && hour < CLOSE_HOUR;\nconst order_id = 'F-' + $now.setZone('Africa/Cairo').toFormat('yyMMdd') + '-' + Math.random().toString(36).slice(2, 6).toUpperCase().padEnd(4, 'X');\nlet action = 'reply', reply = '';\nconst notes = [];\nconst intent = ai?.intent;\nif (!intent) {\n  action = 'human';\n  reply = t(\"Sorry, I couldn't read that one. A team member will reply here shortly ☕\", 'معلش مقدرتش أفهم الرسالة دي، حد من الفريق هيرد عليك حالًا ☕');\n} else if (intent === 'greeting' || intent === 'menu') {\n  reply = (intent === 'greeting' ? t('Welcome to Fenjan ☕\\n\\n', 'أهلًا بيك في فنجان ☕\\n\\n') : '') + menuText();\n} else if (intent === 'order' || intent === 'details') {\n  if (ai.replace_cart) cart = [];\n  for (const id of (ai.remove || [])) cart = cart.filter(l => l.item_id !== String(id).trim().toUpperCase());\n  for (const it of (ai.items || [])) {\n    const id = String(it.item_id || '').trim().toUpperCase(), m = byId[id];\n    if (!m) { notes.push(t(`I couldn't find \"${it.item_id}\" on the menu.`, `مش لاقي \"${it.item_id}\" في المنيو.`)); continue; }\n    if (!isOn(m)) { notes.push(t(`${m.name_en} is not available today.`, `${m.name_ar} مش متاح النهاردة.`)); continue; }\n    const qty = Math.min(MAX_QTY, Math.max(1, parseInt(it.qty, 10) || 1));\n    const ex = cart.find(l => l.item_id === id);\n    if (ex) ex.qty = Math.min(MAX_QTY, ex.qty + qty);\n    else cart.push({ item_id: id, name: m.name_en, name_ar: m.name_ar || m.name_en, price: Number(m.price_egp) || 0, qty });\n  }\n  if (!cart.length) {\n    action = cartRow ? 'clear' : 'reply';\n    reply = (notes.length ? notes.join('\\n') + '\\n\\n' : '') + menuText();\n  } else {\n    action = 'cart';\n    reply = (notes.length ? notes.join('\\n') + '\\n\\n' : '') + t('🧾 Your order:\\n', '🧾 طلبك:\\n') + cartText() + '\\n\\n' + nextStep();\n  }\n} else if (intent === 'confirm') {\n  if (!cart.length) reply = t('Your cart is empty. Tell me what you would like 😊\\n\\n', 'السلة فاضية، قولي تحب تطلب إيه 😊\\n\\n') + menuText();\n  else if (!fulfilment || (fulfilment === 'delivery' && !address)) { action = 'cart'; reply = t('Almost there! ', 'قربنا نخلص! ') + nextStep(); }\n  else if (!isOpen) { action = 'cart'; reply = t(`We are closed now (open ${OPEN_HOUR}:00 until midnight). Your cart is saved, confirm again when we open 🌙`, `إحنا مقفولين دلوقتي (بنفتح ${OPEN_HOUR}:00 الصبح لحد منتصف الليل). سلتك محفوظة، أكد تاني لما نفتح 🌙`); }\n  else {\n    action = 'confirm';\n    reply = t(`✅ Order ${order_id} confirmed!\\n\\n`, `✅ تم تأكيد طلبك ${order_id}!\\n\\n`) + cartText() + '\\n\\n'\n      + (fulfilment === 'delivery' ? t(`🛵 Delivery to: ${address}\\nWe will message you when it is on the way.`, `🛵 التوصيل على: ${address}\\nهنبعتلك أول ما يخرج للتوصيل.`)\n        : t('We will message you when it is ready for pickup ☕', 'هنبعتلك أول ما يجهز للاستلام ☕'));\n  }\n} else if (intent === 'cancel') {\n  action = cartRow ? 'clear' : 'reply';\n  reply = t('Done, your cart is cleared. Send anything to start again.', 'تمام، السلة اتمسحت. ابعت أي حاجة نبدأ من جديد.');\n} else if (intent === 'human') {\n  action = 'human';\n  reply = t('Sure, a team member will reply here shortly 🙏', 'أكيد، حد من الفريق هيرد عليك حالًا 🙏');\n} else {\n  reply = (String(ai.answer || '').trim().slice(0, 600) || t('How can I help? Type \"menu\" to see what we have.', 'أقدر أساعدك إزاي؟ اكتب \"منيو\" عشان تشوف عندنا إيه.'))\n    + (cart.length ? '\\n\\n' + t('Your cart:\\n', 'سلتك:\\n') + cartText() + '\\n\\n' + nextStep() : '');\n}\nreturn [{ json: {\n  action, intent: intent || 'unreadable', reply: reply.slice(0, 1900), platform: msg.platform, sender_id: msg.sender_id, text: msg.text, language: ar ? 'ar' : 'en',\n  order_id, items_json: JSON.stringify(cart), items_text: cart.map(l => `${l.qty} × ${l.name}`).join(', '),\n  subtotal: sub(), delivery: fee(), total: sub() + fee(), fulfilment, address,\n  now: $now.setZone('Africa/Cairo').toFormat('yyyy-MM-dd HH:mm'),\n} }];"
      },
