    {
      "parameters": {
        "jsCode": "const f = $('Kitchen Update').first().json;\nconst id = String(f.order_id || f['Order ID'] || '').trim().toUpperCase(), status = f.status || f['Status'], note = String(f.note || f['Note for the customer (optional)'] || '').trim().slice(0, 300);\nconst o = $input.all().map(i => i.json).find(r => String(r.order_id || '').toUpperCase() === id);\nconst problems = [];\nif (!/^F-\\d{6}-[A-Z0-9]{4}$/.test(id)) problems.push('Order ID should look like F-261119-AB12');\nelse if (!o) problems.push(`Order ${id} was not found in the Orders sheet`);\nelse if (o.status === 'cancelled' && status !== 'cancelled') problems.push(`Order ${id} is already cancelled`);\nif (o && status === 'out_for_delivery' && o.fulfilment !== 'delivery') problems.push(`Order ${id} is a pickup order`);\nconst ar = o?.language === 'ar';\nconst t = (en, a) => ar ? a : en;\nconst msgs = {\n  preparing: t(`👩‍🍳 We are preparing your order ${id} now.`, `👩‍🍳 طلبك ${id} بيتحضر دلوقتي.`),\n  ready: t(`☕ Your order ${id} is ready for pickup! See you at Fenjan.`, `☕ طلبك ${id} جاهز للاستلام! نورتنا في فنجان.`),\n  out_for_delivery: t(`🛵 Your order ${id} is on the way to ${o?.address || 'you'}.`, `🛵 طلبك ${id} في الطريق ليك على ${o?.address || 'عنوانك'}.`),\n  cancelled: t(`😔 Sorry, we had to cancel order ${id}. Reply here and we will sort it out.`, `😔 آسفين، اضطرينا نلغي الطلب ${id}. ردّ علينا هنا وهنحلها.`),\n};\nreturn [{ json: { ok: problems.length === 0, problems, order_id: id, status, customer_id: o?.customer_id || '', platform: o?.platform || '',\n  message: (msgs[status] || '') + (note ? '\\n' + note : ''), now: $now.setZone('Africa/Cairo').toFormat('yyyy-MM-dd HH:mm') } }];"
      },
