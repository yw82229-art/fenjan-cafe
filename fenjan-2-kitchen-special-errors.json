        "jsCode": "const today = $now.setZone('Africa/Cairo').toFormat('yyyy-MM-dd');\nconst row = $input.all().map(i => i.json).find(r => String(r.date).trim() === today && String(r.posted).trim().toLowerCase() !== 'yes' && String(r.text || '').trim());\nreturn row ? [{ json: { date: today, text: String(row.text).slice(0, 2000) } }] : [];"
